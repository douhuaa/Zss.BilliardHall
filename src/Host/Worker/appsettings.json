{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Wolverine": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=zss_billiard_hall;Username=YOUR_DB_USERNAME;Password=YOUR_DB_PASSWORD"
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Modules": {
    "_comment": "模块加载现在使用类型安全的 ModuleRegistry（Host 层）。配置 Enabled 字段可控制启用哪些模块。如不配置，默认启用所有注册的模块。支持短名称（Members）或完整名称（Zss.BilliardHall.Members）。",
    "Enabled": [
      "Zss.BilliardHall.Members",
      "Zss.BilliardHall.Orders"
    ]
  }
}
